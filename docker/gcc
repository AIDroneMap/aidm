#!/bin/bash

# Compile everything for the CPU target of the AIDM images, whatever
# -march a build system asks for, -march=native included. See docker/README.

# x86-64-v3: AVX2, FMA and BMI2 (Intel Haswell, AMD Zen and later).
# armv8.2-a: AWS Graviton 2, Ampere Altra, Apple M1, Raspberry Pi 5 and later.
ARCH=x86-64-v3
if [[ $(uname -m) == "aarch64" ]]; then
    ARCH=armv8.2-a
fi

# Drop every -march flag except the target plus extensions, for example
# -march=armv8.2-a+dotprod. OpenCV compiles its dispatched kernels with such
# a flag, one file each, and runs them only on CPUs that have the extension.
# Dropping it turned off OpenCV's NEON_FP16, NEON_BF16 and NEON_DOTPROD code
# on arm64 (issue #10). The kept flag comes after the forced one, so it
# applies to that file only. A "+no..." extension would compile below the
# target, so it is dropped. x86-64 has no such flags: OpenCV uses -mavx2 and
# similar there, and those always pass.
declare -a args

for i in "$@"
do
    if [[ "$i" == -march=$ARCH+* && "$i" != *+no* ]]; then
        args+=("$i")
    elif [[ "$i" != -march* ]]; then
        args+=("$i")
    fi
done

/usr/bin/gcc_real -march=$ARCH "${args[@]}"
